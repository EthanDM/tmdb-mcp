{
  "name": "tmdb-mcp",
  "version": "0.1.0",
  "description": "Local read-only TMDB MCP server for movie, TV, and people discovery",
  "private": true,
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tmdb",
    "movies",
    "tv",
    "discovery"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "smoke": "tsx src/smoke.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.6.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.0",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "ip-address": "10.5.0"
    }
  }
}
